# Copy to .env (setup.sh does this for you). Never paste these values in a chat.

# First login (only used on the very first start). Two-factor login is set up at that first login.
ADMIN_NAME=Soufyan
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI mode:
#   local  (default) everything on this machine with Ollama; nothing goes to any AI service
#   hybrid page images stay here; only pseudonymised TEXT goes to Claude (needs ANTHROPIC_API_KEY)
#   replay no AI, replays the sample scan (for a quick demo)
SCAN_AI=local
OLLAMA_URL=http://127.0.0.1:11434
# Only Apache 2.0 models are accepted (models.py). qwen2.5:3b is refused (Qwen Research licence).
LOCAL_MODEL=qwen2.5vl:7b
ANON_MODEL=qwen2.5:7b

# Only used in hybrid mode
ANTHROPIC_API_KEY=

# Encryption keys: created by setup.sh as .vault-key and .backup-key (mode 600). Keep a copy apart from backups.
# VAULT_KEY_FILE=.vault-key
# BACKUP_KEY_FILE=.backup-key
# BACKUP_KEEP_DAYS=7

# Retention: check every 5 minutes; documents taken out of the pile are wiped after 24 hours
# RETENTION_INTERVAL=300
# REJECTED_GRACE_HOURS=24

# Sending approved messages (optional; without these an approved message is logged, not sent)
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  SMTP_FROM=
# WHATSAPP_TOKEN=  WHATSAPP_PHONE_NUMBER_ID=  WHATSAPP_VERIFY_TOKEN=  WHATSAPP_APP_SECRET=

# Exact Online (optional): register a free app in the Exact App Center
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=

# Production only (not used on a laptop): the app refuses to start unless both are fsn1 or nbg1 (Hetzner, Germany)
APP_ENV=development
# HOSTING_LOCATION=fsn1
# BACKUP_LOCATION=fsn1
# SECURE_COOKIES=1
# BRAND_NAME=Scanstraat
